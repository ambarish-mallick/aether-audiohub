#!/bin/zsh
# Aether — developed by Ambarish Mallick. Copyright (c) 2026 Ambarish Mallick. SPDX-License-Identifier: MIT
# Verifies dist/Aether.app: signature, required Info.plist keys, binary hash.
set -euo pipefail
cd "$(dirname "$0")/.."
APP=dist/Aether.app
[[ -d $APP ]] || { echo "✗ $APP missing — run scripts/build-macos"; exit 1; }
codesign --verify --deep --strict "$APP" && echo "✓ signature valid ($(codesign -dv "$APP" 2>&1 | grep -E '^Signature' || echo 'Signature=adhoc'))"
for key in CFBundleIdentifier NSAudioCaptureUsageDescription LSMinimumSystemVersion NSHumanReadableCopyright; do
  v=$(/usr/libexec/PlistBuddy -c "Print :$key" "$APP/Contents/Info.plist" 2>/dev/null) || { echo "✗ Info.plist missing $key"; exit 1; }
  echo "✓ $key = $v"
done
[[ -f $APP/Contents/Resources/Aether.icns ]] && echo "✓ icon present"
echo "SHA-256 $(shasum -a 256 "$APP/Contents/MacOS/Aether" | cut -d' ' -f1)  Contents/MacOS/Aether"
