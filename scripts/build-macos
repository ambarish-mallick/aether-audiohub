#!/bin/zsh
# Aether — developed by Ambarish Mallick. Copyright (c) 2026 Ambarish Mallick. SPDX-License-Identifier: MIT
# Builds dist/Aether.app: universal (Apple silicon + Intel) release binary, Info.plist
# with the system-audio usage string, generated icon, hardened-runtime signature.
#
#   AETHER_SIGN_IDENTITY   "Developer ID Application: …" to sign for distribution;
#                          default "-" (ad-hoc: runs here, Gatekeeper asks once elsewhere)
#   AETHER_ARCHS           default "arm64 x86_64"
set -euo pipefail
cd "$(dirname "$0")/.."
ROOT=$PWD
VERSION=$(tr -d '[:space:]' < VERSION)
BUILD=$(date -u +%Y%m%d%H%M)
IDENTITY=${AETHER_SIGN_IDENTITY:--}
ARCHS=(${=AETHER_ARCHS:-arm64 x86_64})
APP="$ROOT/dist/Aether.app"

SLICES=()
for arch in $ARCHS; do
  swift build -c release --product Aether --triple "$arch-apple-macosx14.4" --scratch-path ".build-$arch"
  SLICES+=("$(swift build -c release --triple "$arch-apple-macosx14.4" --scratch-path ".build-$arch" --show-bin-path)/Aether")
done

rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
lipo -create "${SLICES[@]}" -output "$APP/Contents/MacOS/Aether"
lipo -info "$APP/Contents/MacOS/Aether"

ICONWORK="$ROOT/.build/icon"
rm -rf "$ICONWORK" && mkdir -p "$ICONWORK/Aether.iconset"
swift "$ROOT/scripts/make-icon.swift" "$ICONWORK/icon.png"
for s in 16 32 128 256 512; do
  sips -z $s $s "$ICONWORK/icon.png" --out "$ICONWORK/Aether.iconset/icon_${s}x${s}.png" >/dev/null
  sips -z $((s*2)) $((s*2)) "$ICONWORK/icon.png" --out "$ICONWORK/Aether.iconset/icon_${s}x${s}@2x.png" >/dev/null
done
iconutil -c icns "$ICONWORK/Aether.iconset" -o "$APP/Contents/Resources/Aether.icns"

cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Aether</string>
  <key>CFBundleDisplayName</key><string>Aether</string>
  <key>CFBundleIdentifier</key><string>com.ambarishmallick.aether</string>
  <key>CFBundleExecutable</key><string>Aether</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleVersion</key><string>$BUILD</string>
  <key>CFBundleIconFile</key><string>Aether</string>
  <key>LSMinimumSystemVersion</key><string>14.4</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.music</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>NSHumanReadableCopyright</key><string>© 2026 Ambarish Mallick. A project by Ambarish Mallick.</string>
  <key>NSAudioCaptureUsageDescription</key>
  <string>Aether reads the mixed system audio only to spatialise it in real time for your in-ear monitors. Nothing is recorded, stored or sent.</string>
</dict>
</plist>
PLIST

if [[ $IDENTITY == "-" ]]; then
  codesign --force --sign - --options runtime --entitlements packaging/Aether.entitlements --timestamp=none "$APP"
else
  codesign --force --sign "$IDENTITY" --options runtime --entitlements packaging/Aether.entitlements --timestamp "$APP"
fi
codesign --verify --deep --strict "$APP"
echo "Built $APP ($VERSION, build $BUILD, signed: $IDENTITY)"
